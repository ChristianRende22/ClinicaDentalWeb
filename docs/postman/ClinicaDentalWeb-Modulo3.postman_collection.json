                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('recorta los espacios del nombre', () => pm.expect(body.nombre).to.eql('Ortodoncia'));",
                  "pm.test('nace activa', () => pm.expect(body.activo).to.eql(true));",
                  "pm.collectionVariables.set('idEspecialidad', body.id_especialidad);"
