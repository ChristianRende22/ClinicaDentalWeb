          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const id = String(pm.collectionVariables.get('idEspecialidad'));",
                  "const encontrada = pm.response.json().find(e => String(e.id_especialidad) === id);",
                  "pm.test('la fila sigue existiendo', () => pm.expect(encontrada).to.not.be.undefined);",
                  "pm.test('quedo inactiva, no borrada', () => pm.expect(encontrada.activo).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": {
              "raw": "{{baseUrl}}/especialidades?incluir_inactivos=true",
              "host": ["{{baseUrl}}"],
              "path": ["especialidades"],
              "query": [{ "key": "incluir_inactivos", "value": "true" }]
            }
          }
        }
      ]
    },
