    {
      "name": "4. Horario de atencion",
      "item": [
        {
          "name": "GET horarios (7 dias con defaults)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const dias = pm.response.json();",
                  "pm.test('devuelve los 7 dias en orden', () => pm.expect(dias.map(d => d.dia_semana)).to.eql(['lunes','martes','miercoles','jueves','viernes','sabado','domingo']));",
                  "pm.test('lunes abierto 08:00-17:00', () => { pm.expect(dias[0].hora_apertura).to.eql('08:00:00'); pm.expect(dias[0].hora_cierre).to.eql('17:00:00'); pm.expect(dias[0].cerrado).to.eql(false); });",
                  "pm.test('sabado y domingo cerrados por defecto', () => { pm.expect(dias[5].cerrado).to.eql(true); pm.expect(dias[6].cerrado).to.eql(true); });",
                  "pm.test('los dias cerrados no traen horas', () => pm.expect(dias[6].hora_apertura).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": {
              "raw": "{{baseUrl}}/horarios",
              "host": ["{{baseUrl}}"],
              "path": ["horarios"]
            },
            "description": "Con la tabla vacia devuelve los defaults de HORARIO_POR_DEFECTO sin persistirlos."
          }
        },
        {
          "name": "PUT horarios (sabado 08:00-12:00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const dias = pm.response.json();",
                  "pm.test('el sabado quedo abierto hasta las 12', () => { pm.expect(dias[5].cerrado).to.eql(false); pm.expect(dias[5].hora_cierre).to.eql('12:00:00'); });",
                  "// VERIFICACION CLAVE contra MySQL: el tipo Time y el ENUM dia_semana en minuscula."
                ]
              }
            }
          ],
          "request": {
