          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": {
              "raw": "{{baseUrl}}/especialidades/999999",
              "host": ["{{baseUrl}}"],
              "path": ["especialidades", "999999"]
            }
          }
        },
        {
          "name": "Actualizar especialidad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('cambio el nombre', () => pm.expect(pm.response.json().nombre).to.eql('Ortodoncia avanzada'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ortodoncia avanzada\"\n}",
              "options": { "raw": { "language": "json" } }
