    {
      "name": "5. Configuracion",
      "item": [
        {
          "name": "GET configuracion (se crea al vuelo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('duracion de cita 30 min', () => pm.expect(c.duracion_cita_minutos).to.eql(30));",
                  "pm.test('IVA 13.00 (El Salvador)', () => pm.expect(Number(c.porcentaje_impuesto)).to.eql(13));",
                  "pm.test('prefijo de factura F', () => pm.expect(c.prefijo_factura).to.eql('F'));",
                  "pm.test('proximo numero de factura 1', () => pm.expect(c.proximo_numero_factura).to.eql(1));",
                  "pm.test('24 h para cambiar una cita', () => pm.expect(c.horas_minimas_cambio_cita).to.eql(24));",
                  "pm.test('3 dias minimos para reagendar', () => pm.expect(c.dias_minimos_reagendamiento).to.eql(3));",
                  "// VERIFICACION CLAVE contra MySQL: el tipo Numeric(5,2) del impuesto."
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": {
              "raw": "{{baseUrl}}/configuracion",
              "host": ["{{baseUrl}}"],
              "path": ["configuracion"]
            },
            "description": "Es la unica lectura del modulo que escribe: si la clinica no tiene configuracion, la crea con los defaults."
          }
        },
