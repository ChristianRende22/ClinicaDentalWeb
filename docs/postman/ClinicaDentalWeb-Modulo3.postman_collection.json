                  "pm.test('cambio la duracion de cita', () => pm.expect(c.duracion_cita_minutos).to.eql(45));",
                  "pm.test('lo que no se envio quedo igual', () => pm.expect(Number(c.porcentaje_impuesto)).to.eql(13));"
