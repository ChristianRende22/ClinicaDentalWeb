              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"  Ortodoncia  \"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/especialidades",
              "host": ["{{baseUrl}}"],
              "path": ["especialidades"]
            }
          }
        },
        {
          "name": "Crear duplicada (distinto casing) -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('el mensaje explica el conflicto', () => pm.expect(pm.response.json().detail).to.include('especialidad'));",
                  "// VERIFICACION CLAVE contra MySQL: el func.lower() explicito del repositorio.",
                  "// SQLite es case-sensitive por defecto y MySQL utf8mb4_general_ci no lo es."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ORTODONCIA\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/especialidades",
              "host": ["{{baseUrl}}"],
              "path": ["especialidades"]
            }
          }
        },
        {
          "name": "Crear con nombre vacio -> 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 422', () => pm.response.to.have.status(422));"]
